# Supabase (Frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Public addresses required by the production build; these are not secret keys.
VITE_STORE_ASSET_PUBLIC_BASE_URL=https://your-store-assets.example.r2.dev
VITE_CHAPTER_PAGE_PUBLIC_BASE_URL=https://your-chapter-pages.example.r2.dev
VITE_AVATAR_PUBLIC_BASE_URL=
VITE_MANGA_COVER_PUBLIC_BASE_URL=
CF_PAGES_PROJECT_NAME=bsgmanga

# Supabase (Server/Script)
# Do not keep this key in the root .env.
# Preferred: ~/.bsgmanga/supabase-admin.env
# Alternative: point SUPABASE_ADMIN_ENV_FILE to a file outside the repo.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SOURCE_BUCKET=store-assets
CF_R2_TARGET_BUCKET=store-assets

# Translation Studio (Cloudflare server secret/environment only; do not use the VITE_ prefix)
OPENAI_API_KEY=your-server-only-openai-key
STUDIO_AI_MODEL=gpt-4.1
# original can be picked on a supported OCR model; the default is high.
STUDIO_AI_IMAGE_DETAIL=high
# Translation Studio V3: extra model providers (optional) and a daily USD limit per fansub.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TRANSLATION_DAILY_USD_CAP=5

# Optional auth seed overrides
AUTH_SEED_DEFAULT_PASSWORD=Demo12345!
AUTH_SEED_PASSWORD_ADMIN=
AUTH_SEED_PASSWORD_AYLIN=
AUTH_SEED_PASSWORD_KENAN=
AUTH_SEED_PASSWORD_SENA=

# Optional store asset seed
STORE_ASSET_SEED_DRY_RUN=

# Optional follow smoke test overrides
AUTH_SMOKE_EMAIL_A=
AUTH_SMOKE_PASSWORD_A=
AUTH_SMOKE_USER_PUBLIC_ID=22222222-2222-2222-2222-222222222222
AUTH_SMOKE_TARGET_PUBLIC_ID=33333333-3333-3333-3333-333333333333
AUTH_SMOKE_MANGA_ID=70000000-0000-0000-0000-000000000001
AUTH_SMOKE_FANSUB_ID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaa1
