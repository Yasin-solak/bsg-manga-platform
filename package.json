{
  "name": "bsg-manga-platform",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Open-source manga and webtoon community platform: reader, scanlation team tools, cosmetics economy and AI translation studio.",
  "repository": "github:Yasin-solak/bsg-manga-platform",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run optimize:public-assets",
    "build": "tsc -b && vite build && npm run build:ssr && npm run build:prerender",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr-temp",
    "build:prerender": "node scripts/prerender-routes.mjs",
    "cf:precheck": "node scripts/predeploy-cloudflare.mjs",
    "cf:sync-secrets": "node scripts/sync-cloudflare-pages-secrets.mjs",
    "r2:migrate:store-assets:dry": "node scripts/migrate-store-assets-to-r2.mjs",
    "r2:migrate:store-assets:apply": "node scripts/migrate-store-assets-to-r2.mjs --apply",
    "r2:migrate:chapter-pages:dry": "node scripts/migrate-store-assets-to-r2.mjs --source-bucket=chapter-pages --target-bucket=chapter-pages",
    "r2:migrate:chapter-pages:apply": "node scripts/migrate-store-assets-to-r2.mjs --apply --source-bucket=chapter-pages --target-bucket=chapter-pages",
    "r2:migrate:legacy-media:dry": "node scripts/migrate-legacy-media-to-r2.mjs",
    "r2:migrate:legacy-media:apply": "node scripts/migrate-legacy-media-to-r2.mjs --apply",
    "lint": "eslint .",
    "test:contracts": "node tests/contracts/run-all-contracts.mjs",
    "lint:text": "node scripts/check-mojibake.mjs",
    "preview": "vite preview",
    "deploy:cf": "npm run build && npm run cf:precheck && npx wrangler pages deploy dist --project-name=bsgmanga --commit-dirty=true",
    "e2e:manga-comment-report": "playwright test --config playwright.config.ts tests/e2e/manga-comment-report.spec.ts",
    "smoke:chapter-credit": "playwright test --config playwright.config.ts tests/e2e/chapter-credit-management.spec.ts tests/e2e/chapter-credit-visual-smoke.spec.ts",
    "smoke:boost-policy": "node tests/contracts/run-boost-policy-contracts.mjs && playwright test --config playwright.config.ts tests/e2e/admin-boost-downgrade-smoke.spec.ts",
    "e2e:browser-smoke": "playwright test --config playwright.config.ts",
    "seed:auth-users": "node scripts/seed-auth-users.mjs",
    "seed:store-assets": "node scripts/seed-store-assets.mjs",
    "seed:manga-showcase": "node scripts/reset-and-seed-manga-showcase.mjs",
    "smoke:follow-rpc": "node scripts/smoke-follow-rpc.mjs",
    "smoke:core-flows": "node scripts/smoke-core-flows.mjs",
    "smoke:storage-auth": "node scripts/smoke-storage-auth.mjs",
    "store:audit-assets": "node scripts/audit-clean-store-assets.mjs",
    "audit:content": "node scripts/audit-suspicious-content.mjs",
    "audit:anon": "node scripts/audit-anon-exposure.mjs",
    "audit:idor": "node scripts/audit-idor-mutations.mjs",
    "audit:escalation": "node scripts/audit-privilege-escalation.mjs",
    "content:purge": "node scripts/purge-junk-content.mjs",
    "seed:catalog-covers": "node scripts/generate-catalog-covers.mjs",
    "seed:rich-catalog": "node scripts/seed-rich-catalog.mjs",
    "optimize:public-assets": "node scripts/optimize-public-assets.mjs",
    "i18n:db-report": "node scripts/i18n-db-text-report.mjs",
    "health:repo": "node scripts/repo-health-audit.mjs",
    "health:repo:strict": "node scripts/repo-health-audit.mjs --fail-on-regression",
    "audit:deep": "node scripts/deep-audit-suite.mjs",
    "audit:deep:strict": "node scripts/deep-audit-suite.mjs --fail-on-regression",
    "audit:browser:live": "node scripts/browser-live-audit.mjs",
    "test:contracts:reader-comments": "node tests/contracts/run-comment-reader-regression-contracts.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.47.14",
    "@tailwindcss/vite": "4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.37.0",
    "hyphen": "^1.14.1",
    "lucide-react": "^0.564.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.17.0",
    "react-router-dom": "7.17.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.1.18",
    "web-vitals": "6.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "shadcn": "^3.8.4",
    "sharp": "^0.34.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "8.0.16"
  },
  "overrides": {
    "fast-uri": "3.1.2"
  }
}
